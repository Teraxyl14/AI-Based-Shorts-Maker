# Project Aether — Environment Variables
# Copy this file to .env and adjust values as needed.

# NATS message broker URL (Docker service name)
NATS_URL=nats://nats:4222

# vLLM Brain endpoint (Docker service name)
VLLM_BRAIN_URL=http://vllm-brain:8000

# PyTorch CUDA memory configuration
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True,max_split_size_mb:512

# vLLM MoE kernel backend
VLLM_MOE_KERNEL_BACKEND=triton

# YOLO spatial tracker model variant
SPATIAL_TRACKER_MODEL=yolo26s-pose

# Target language for transcription ("auto" for automatic detection)
TARGET_LANGUAGE=auto
